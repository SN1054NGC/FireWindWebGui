# === GUI-панель (первый вход: admin / admin - смените сразу) ===
VDS_ADMIN_USER=admin
VDS_ADMIN_PASS=admin
# Пароль гостевого входа (для гостей)
VDS_GUEST_PASS=change-me
# Секрет Flask: сгенерируйте openssl rand -hex 32
VDS_SECRET=
# Где слушает панель (наружу отдаёт nginx) и её публичный адрес
VDS_BIND=127.0.0.1:8010
VDS_BASE_URL=https://vpn.example.com
VDS_DB=/opt/vds-panel/panel.db
# OpenVPN
VDS_OVPN_TEMPLATE=/etc/openvpn/server/client-template.ovpn
VDS_OVPN_USERS=/etc/openvpn/server/users.txt
# VLESS / Xray (необязательно)
VDS_XRAY_DIR=/root/xray_host_script
VDS_AWG_BIN=/usr/local/bin/awg-client
VDS_AWG_CLIENTS=/etc/amnezia/awg/clients